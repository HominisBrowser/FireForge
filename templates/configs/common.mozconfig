# Common mozconfig for ${name}
# FireForge joins this file with the platform's into engine/mozconfig and
# substitutes the project's name, vendor, appId and binaryName placeholders.
# FireForge places the object directory itself: a template that sets
# MOZ_OBJDIR is refused.

# Application identity
ac_add_options --with-app-name=${binaryName}
export MOZ_APP_BASENAME=${binaryName}

# Branding: uncomment once the engine holds browser/branding/${binaryName}
# (with its moz.build). A build refuses a branding directory the engine lacks.
# ac_add_options --with-branding=browser/branding/${binaryName}

# Build options
ac_add_options --enable-application=browser
ac_add_options --enable-bootstrap

# Optimization (override in platform configs as needed)
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Disable crash reporting
ac_add_options --disable-crashreporter

# Note: To disable telemetry, set MOZ_TELEMETRY_REPORTING= in your build environment
# or configure runtime prefs in user.js

# Disable features we don't need
ac_add_options --disable-updater
