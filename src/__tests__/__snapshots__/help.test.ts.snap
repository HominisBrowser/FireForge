// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`CLI help output > documents kebab-case setup flags and configurable categories > lint --help 1`] = `
"Usage: fireforge lint [options] [command] [paths...]

Lint engine changes against patch quality rules. Default: aggregate diff against
HEAD (every applied patch summed). Use --per-patch for per-patch scope, or pass
explicit file paths to narrow to those.

Options:
  --since <git-rev>     Tag issues as [introduced] or [cumulative] based on
                        whether the file changed since <git-rev> (e.g. HEAD, a
                        branch, a SHA)
  --only-introduced     Fail only on issues tagged [introduced] (requires
                        --since). Cumulative errors still print but do not set a
                        non-zero exit.
  --per-patch           Lint each patch in the queue as its own isolated diff.
                        Rescopes patch-size rules so they fire against
                        individual patches rather than the aggregate. Honours
                        each patch's \`lintIgnore\` entries.
  --patches <names...>  With --per-patch, lint only the named patches. Accepts
                        repeated flags, comma lists, full filenames/stems,
                        manifest names, category-prefixed slugs, or bare slugs.
                        Positional arguments after --per-patch are treated the
                        same way.
  --max-warnings <n>    Fail when lint reports more than <n> warning(s); use 0
                        for warning-clean release gates.
  --no-cache            Bypass per-patch lint result cache reads and writes.
  --report <path>       With --per-patch, write a machine-readable JSON report
                        (per-patch size metrics, tier, thresholds, issues, and
                        lintIgnore-suppressed issues) to <path>.
  -h, --help            display help for command

Commands:
  cache                 Manage the per-patch lint result cache
"
`;

exports[`CLI help output > documents kebab-case setup flags and configurable categories > lint cache clear --help 1`] = `
"Usage: fireforge lint cache clear [options]

Clear cached per-patch lint results

Options:
  -h, --help  display help for command
"
`;

exports[`CLI help output > documents kebab-case setup flags and configurable categories 1`] = `
"Usage: fireforge [options] [command]

A build tool for customizing Firefox

Options:
  -V, --version                     output the version number
  -v, --verbose                     Enable debug output
  --ignore-corrupt-tree-marker      Run even when .fireforge/tree.json exists
                                    but cannot be parsed. Without this the tree
                                    guard refuses, because an unreadable marker
                                    leaves it unknown whether this is a snapshot
                                    or the primary tree.
  -h, --help                        display help for command

Project:
  setup [options]                   Initialize a new FireForge project
  source                            Manage Firefox source configuration
  config [options] <key> [value]    Get or set configuration values

Engine:
  download [options]                Download Firefox source
  bootstrap                         Install Firefox build dependencies

Workflow:
  import [options]                  Apply patches from the patches directory
  resolve [options]                 Update a broken patch with manual fixes
                                    (then run "fireforge import" to resume the
                                    queue)
  build [options]                   Build the browser (auto-applies Furnace
                                    components first)
  run [options]                     Launch the built browser
  status [options]                  Show modified files in engine/
  reset [options]                   Reset engine/ to clean state
  discard [options] <file>          Discard changes to a specific file,
                                    restoring patch-claimed paths to their
                                    patch-applied baseline (unmanaged untracked
                                    files are deleted). Pass a directory path to
                                    discard every modified or untracked file
                                    beneath it; the operation walks the status
                                    output and reverts each match individually.
  export [options] <paths...>       Export new changes as a patch (use re-export
                                    to update existing patches)
  export-all [options]              Export all changes as a patch
  re-export [options] [patches...]  Refresh existing patch bodies (and
                                    filesAffected with --scan) from the current
                                    engine state. Does NOT change
                                    sourceVersion/sourceProduct by default — use
                                    --stamp or run rebase for source metadata
                                    stamping.
  patch                             Manage individual patches in the queue
                                    (compact, delete, lint-ignore, move-files,
                                    rename, reorder, staged-dependency, tier)
  rebase [options]                  Semi-automated Firefox source version
                                    upgrade — apply patches with drift tolerance
                                    and re-export
  package [options]                 Create distribution package
  watch                             Watch for changes and auto-rebuild
  test [options] [paths...]         Run tests via mach test
  tree                              Manage copy-on-write verification clones of
                                    this project for concurrent read-mostly work
                                    (lint, typecheck, status, verify,
                                    export/re-export --dry-run; build-less test
                                    with create --with-objdir). Mutation
                                    commands are refused inside a tree.
  register [options] <path>         Register a file in the appropriate build
                                    manifest
  wire [options] <name>             Wire a chrome subscript into the browser

Components:
  token                             Design token management
  furnace                           Component management — create, override,
                                    apply, deploy, diff, validate, sync (run
                                    furnace --help for all subcommands)

Diagnostics:
  doctor [options]                  Diagnose project issues
  lint [options] [paths...]         Lint engine changes against patch quality
                                    rules. Default: aggregate diff against HEAD
                                    (every applied patch summed). Use
                                    --per-patch for per-patch scope, or pass
                                    explicit file paths to narrow to those.
  typecheck [options]               Run TypeScript type checking against
                                    project-owned jsconfig.json files (CI-grade,
                                    whole-project)
  verify                            Read-only fsck for the patch queue (manifest
                                    + cross-patch lint)

  help [command]                    display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace apply --help 1`] = `
"Usage: fireforge furnace apply [options] [name]

Apply components to the engine (optionally a single component)

Options:
  --dry-run              Show what would be changed without writing (reads may
                         overlap concurrent mutations)
  --force                Proceed despite baseVersion drift (stale overrides)
  -w, --watch            Watch component directories and re-apply on changes
  --wait-lock [seconds]  Wait up to this many seconds (default 60) for another
                         FireForge command to release the contended lock,
                         instead of failing on the default budget
  -h, --help             display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace chrome-doc --help 1`] = `
"Usage: fireforge furnace chrome-doc [options] [command]

Scaffold top-level chrome documents (xhtml + js + css + ftl + jar.mn)

Options:
  -h, --help               display help for command

Commands:
  create [options] <name>  Scaffold a new top-level chrome document
  remove [options] <name>  Remove a scaffolded top-level chrome document
  help [command]           display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace create --help 1`] = `
"Usage: fireforge furnace create [options] [name]

Create a new custom component

Options:
  -d, --description <desc>  Component description
  --localized               Include Fluent l10n support
  --no-register             Skip customElements.js registration
  --with-tests              Scaffold a test harness (defaults to browser-chrome;
                            use --test-style=mochikit for tabbrowser-less chrome
                            — may be flaky on macOS)
  --xpcshell                Scaffold an xpcshell test harness (for storage-layer
                            code on forks without tabbrowser); equivalent to
                            --test-style=xpcshell. Note: xpcshell resolves
                            chrome://global/* URIs but not chrome://browser/* —
                            use --test-style=browser-chrome for
                            browser-chrome-dependent tests.
  --test-style <style>      Override the harness written by --with-tests:
                            browser-chrome (default, needs tabbrowser), mochikit
                            (toolkit/widgets, non-tabbrowser chrome), or
                            xpcshell (headless)
  --test-dir <dir>          Redirect the --with-tests scaffold to this
                            engine-relative directory under
                            browser/base/content/test/ (browser-chrome and
                            xpcshell styles) instead of the default
                            <binaryName>-derived directory; existing manifests
                            are appended to, never overwritten
  --compose <tags>          Record stock tags composed internally (metadata
                            only, comma-separated)
  --shared-ftl <path>       Participate in an existing feature-scoped .ftl at
                            this path (e.g. "browser/mybrowser-dock.ftl"); skips
                            the per-component .ftl scaffold (implies
                            --localized)
  --dry-run                 Show the planned file set and furnace.json changes
                            without writing
  --allow-prefix-mismatch   Create the component even when its name does not
                            start with the configured \`componentPrefix\` in
                            furnace.json. Without this flag the command refuses
                            to write anything on a prefix mismatch.
  -h, --help                display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace deploy --help 1`] = `
"Usage: fireforge furnace deploy [options] [name]

Apply components and validate in one step

Options:
  --dry-run              Show what would be changed without writing (reads may
                         overlap concurrent mutations)
  --force                Proceed despite baseVersion drift (stale overrides)
  --skip-validate        Skip the validation step (apply only)
  --wait-lock [seconds]  Wait up to this many seconds (default 60) for another
                         FireForge command to release the contended lock,
                         instead of failing on the default budget
  -h, --help             display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace diff --help 1`] = `
"Usage: fireforge furnace diff [options] [name]

Show changes vs baseline (overrides: vs Firefox original, custom: vs engine).
Shows all components when name is omitted.

Options:
  -h, --help  display help for command
"
`;

