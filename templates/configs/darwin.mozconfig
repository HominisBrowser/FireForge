# macOS-specific mozconfig for ${name}

# MOZ_MACBUNDLE_ID comes from the branding directory's configure.sh, not from
# this file; FireForge passes the rest of the application ID as
# --with-distribution-id.

# --enable-bootstrap (common.mozconfig) provides the macOS SDK. To build
# against a local one instead:
# ac_add_options --with-macos-sdk=/path/to/MacOSX.sdk
