{
  "name": "@hominis/fireforge",
  "version": "0.56.0",
  "description": "FireForge \u2014 a build tool for customizing Firefox",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./*": null
  },
  "bin": {
    "fireforge": "./dist/bin/fireforge.js"
  },
  "scripts": {
    "fireforge": "tsx bin/fireforge.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && node ./scripts/generate-build-info.mjs",
    "clean": "node ./scripts/clean.mjs",
    "lint": "eslint src/ bin/ runtime/ scripts/ eslint-rules/ eslint.config.js vitest.config.ts vitest.pack.config.ts",
    "lint:ci": "eslint src/ bin/ runtime/ scripts/ eslint-rules/ eslint.config.js vitest.config.ts vitest.pack.config.ts --max-warnings 0",
    "lint:fix": "eslint src/ bin/ runtime/ scripts/ eslint-rules/ eslint.config.js vitest.config.ts vitest.pack.config.ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deadcode:check": "knip",
    "deadcode:check:production": "knip --production --config knip.production.json",
    "cycles:check": "dpdm --no-output --no-tree --no-warning --exit-code circular:1 src/index.ts bin/fireforge.ts",
    "test": "vitest run",
    "test:package": "npm run pack:verify",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node ./scripts/check-coverage-thresholds.mjs",
    "test:firefox-full": "node ./scripts/run-full-firefox-integration.mjs",
    "whitespace:check": "node ./scripts/check-worktree-whitespace.mjs",
    "pack:verify": "vitest run --config vitest.pack.config.ts",
    "pack:dry-run": "npm pack --dry-run --json --silent",
    "format": "prettier --write --ignore-unknown \"src/**/*.ts\" \"src/**/*.cjs\" \"bin/**/*.ts\" \"runtime/**/*.cjs\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.js\" \"package.json\" \"eslint.config.js\" \"vitest.config.ts\" \"vitest.pack.config.ts\" \"tsconfig.json\" \"tsconfig.build.json\" \".lintstagedrc.json\" \".prettierignore\" \".prettierrc\" \".gitignore\" \"README.md\" \"CHANGELOG.md\" \"docs/**/*.md\" \"knip.json\" \"knip.production.json\"",
    "format:check": "prettier --check --ignore-unknown \"src/**/*.ts\" \"src/**/*.cjs\" \"bin/**/*.ts\" \"runtime/**/*.cjs\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.js\" \"package.json\" \"eslint.config.js\" \"vitest.config.ts\" \"vitest.pack.config.ts\" \"tsconfig.json\" \"tsconfig.build.json\" \".lintstagedrc.json\" \".prettierignore\" \".prettierrc\" \".gitignore\" \"README.md\" \"CHANGELOG.md\" \"docs/**/*.md\" \"knip.json\" \"knip.production.json\"",
    "prepare": "node -e \"import('./scripts/prepare.mjs').catch((error) => { if (error && typeof error === 'object' && 'code' in error && error.code === 'ERR_MODULE_NOT_FOUND') process.exit(0); throw error; })\"",
    "prepack": "npm run build && node ./scripts/generate-build-info.mjs --loud",
    "release:check": "npm run toolchain:check && npm run format:check && npm run whitespace:check && npm run lint:ci && npm run typecheck && npm run deadcode:check && npm run deadcode:check:production && npm run cycles:check && npm run test:coverage && npm run pack:verify",
    "prepublishOnly": "npm run release:check",
    "toolchain:check": "node ./scripts/check-release-toolchain.mjs"
  },
  "files": [
    "dist/",
    "runtime/",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/",
    "!dist/**/test-utils/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts",
    "dist/src/core/authored/types.d.ts",
    "dist/src/core/authored/write-lock.d.ts",
    "dist/src/core/config-mutate.d.ts",
    "dist/src/core/config-paths.d.ts",
    "dist/src/core/config-state.d.ts",
    "dist/src/core/config-validate.d.ts",
    "dist/src/core/config.d.ts",
    "dist/src/core/forward-registrations.d.ts",
    "dist/src/core/furnace-apply-helpers.d.ts",
    "dist/src/core/furnace-apply.d.ts",
    "dist/src/core/furnace-checksum-utils.d.ts",
    "dist/src/core/furnace-config.d.ts",
    "dist/src/core/furnace-graph-utils.d.ts",
    "dist/src/core/furnace-operation.d.ts",
    "dist/src/core/furnace-rollback.d.ts",
    "dist/src/core/furnace-source-files.d.ts",
    "dist/src/core/furnace-validate.d.ts",
    "dist/src/core/license-headers.d.ts",
    "dist/src/core/patch-lint-assertion.d.ts",
    "dist/src/core/patch-lint-code-lines.d.ts",
    "dist/src/core/patch-lint-creators.d.ts",
    "dist/src/core/patch-lint-cross.d.ts",
    "dist/src/core/patch-lint-css.d.ts",
    "dist/src/core/patch-lint-diff.d.ts",
    "dist/src/core/patch-lint-file-size.d.ts",
    "dist/src/core/patch-lint-forward-registration-extended.d.ts",
    "dist/src/core/patch-lint-ignore.d.ts",
    "dist/src/core/patch-lint-queue-types.d.ts",
    "dist/src/core/patch-lint-size-thresholds.d.ts",
    "dist/src/core/patch-lint-size.d.ts",
    "dist/src/core/patch-lint.d.ts",
    "dist/src/core/patch-policy-content.d.ts",
    "dist/src/core/patch-policy.d.ts",
    "dist/src/core/token-category.d.ts",
    "dist/src/core/token-manager.d.ts",
    "dist/src/errors/base.d.ts",
    "dist/src/errors/codes.d.ts",
    "dist/src/index.d.ts",
    "dist/src/types/commands/index.d.ts",
    "dist/src/types/commands/options.d.ts",
    "dist/src/types/commands/patches.d.ts",
    "dist/src/types/commands/project.d.ts",
    "dist/src/types/config.d.ts",
    "dist/src/types/furnace.d.ts",
    "dist/src/types/index.d.ts",
    "dist/src/types/json.d.ts",
    "templates/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "acorn": "^8.14.0",
    "commander": "^15.0.0",
    "estree-walker": "^3.0.3",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^1.4.5",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.0",
    "dpdm": "4.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "knip": "6.44.0",
    "lint-staged": "^17.0.4",
    "prettier": "3.9.10",
    "tsx": "^4.7.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.7",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@11.12.1",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/HominisBrowser/FireForge.git"
  },
  "homepage": "https://github.com/HominisBrowser/FireForge",
  "bugs": {
    "url": "https://github.com/HominisBrowser/FireForge/issues"
  },
  "keywords": [
    "fireforge",
    "firefox",
    "browser",
    "build-tool",
    "customization",
    "patch-workflow"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
