exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace refresh --help 1`] = `
"Usage: fireforge furnace refresh [options] [name]

Merge upstream Firefox changes into overrides (three-way merge)

Options:
  --dry-run                  Show what would change without modifying files
  -a, --all                  Refresh all overrides in a single batch
  -s, --strategy <strategy>  Auto-resolve conflicts (ours = keep local, theirs =
                             accept upstream) (choices: "ours", "theirs")
  --reset-base               Reset baseline to current engine HEAD (skips
                             three-way merge, recovers from missing baseCommit)
  -h, --help                 display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace remove --help 1`] = `
"Usage: fireforge furnace remove [options] <name>

Remove a component from the workspace

Options:
  -y, --yes   Skip confirmation
  -h, --help  display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace rename --help 1`] = `
"Usage: fireforge furnace rename [options] <old-name> <new-name>

Rename a component (updates files, config, and registrations)

Options:
  -h, --help  display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace scan --help 1`] = `
"Usage: fireforge furnace scan [options]

Scan engine for available components. Report-only by default: persist the
discovered inventory into the stock section of furnace.json with --track (or the
interactive prompt); deploy/validate consume the inventory from there.

Options:
  --deep      Search additional Firefox directories beyond the default widgets
              path
  --track     Persist every discovered untracked component into the stock
              section of furnace.json (non-interactive)
  -h, --help  display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace status --help 1`] = `
"Usage: fireforge furnace status [options] [name]

Show component status and registration details

Options:
  -h, --help  display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace sync --help 1`] = `
"Usage: fireforge furnace sync [options]

Refresh drifted overrides and re-apply all components (recommended after
fireforge download)

Options:
  --dry-run                  Show what would change without modifying files
                             (reads may overlap concurrent mutations)
  -s, --strategy <strategy>  Auto-resolve merge conflicts (ours = keep local,
                             theirs = accept upstream) (choices: "ours",
                             "theirs")
  --wait-lock [seconds]      Wait up to this many seconds (default 60) for
                             another FireForge command to release the contended
                             lock, instead of failing on the default budget
  -h, --help                 display help for command
"
`;

exports[`CLI help output > exposes stable help text for every furnace subcommand > furnace validate --help 1`] = `
"Usage: fireforge furnace validate [options] [name]

Run accessibility and compatibility checks

Options:
  --fix       Auto-fix registration issues (missing jar.mn entries,
              customElements.js)
  -h, --help  display help for command
"
`;

exports[`CLI help output > exposes stable help text for patch staged-dependency > patch move-files --help 1`] = `
"Usage: fireforge patch move-files [options] <from> <to>

Preview the re-export commands needed to move file ownership between patches, or
create the target patch and move the files in one transaction with --create
--order <n>.

Options:
  --file <path>             File path relative to engine/ to move (repeatable)
                            (default: [])
  --create                  Create <to> as a new patch and move the files into
                            it (requires --order)
  --order <n>               Exact sparse order for the created patch (only valid
                            with --create)
  --category <category>     Category for the created patch (default: the source
                            patch's)
  -d, --description <desc>  Description for the created patch
  --dry-run                 Show what would happen without writing
  -y, --yes                 Skip confirmation prompt (required for non-TTY)
  --force-unsafe            Bypass projected-lint refusals
  --skip-lint               Skip per-patch lint of the projected bodies
  --wait-lock [seconds]     Wait up to this many seconds (default 60) for
                            another FireForge command to release the contended
                            lock, instead of failing on the default budget
  -h, --help                display help for command
"
`;

exports[`CLI help output > exposes stable help text for patch staged-dependency > patch staged-dependency --help 1`] = `
"Usage: fireforge patch staged-dependency [options] <name>

Edit PatchMetadata.stagedDependencies on a single patch (no .patch body
rewrite).

Options:
  --add                    Add a staged dependency declaration
  --remove                 Remove matching staged dependency declaration(s)
  --clear                  Drop the stagedDependencies field entirely
  --kind <kind>            Declaration shape: "import" (forward import, the
                           default) or "registration" (jar.mn packaging line,
                           customElements or actor registration)
  --file <path>            Declaring file path relative to engine/
  --specifier <specifier>  Exact import specifier as it appears in source
                           (--kind import)
  --line <text>            Registration/packaging line as the patch adds it,
                           compared whitespace-trimmed (--kind registration)
  --creates <path>         Later-created file path relative to engine/
  --owner <patch>          Exact later patch filename expected to create
                           --creates
  --reason <text>          Human-readable rationale stored with the declaration
  --dry-run                Show what would change without writing
  -y, --yes                Record scripted consent in the destructive-operation
                           history log. This command never prompts; the flag
                           exists for workflow uniformity with commands that do.
  -h, --help               display help for command
"
`;
