{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/index.ts", "scripts/*.mjs"],
  "project": ["src/**/*.ts", "bin/**/*.ts", "scripts/**/*.mjs"],
  "ignoreBinaries": ["xcrun", "python3"],
  "ignoreDependencies": ["chrome", "husky"],
  "ignoreExportsUsedInFile": {
    "type": true,
    "interface": true
  }
}
