{
  "name": "@hominis/fireforge",
  "version": "0.60.0",
  "description": "FireForge \u2014 a build tool for customizing Firefox",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "fireforge": "./dist/bin/fireforge.js"
  },
  "scripts": {
    "fireforge": "tsx bin/fireforge.ts",
    "build": "npm run clean && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.build.json && node ./scripts/generate-build-info.mjs",
    "clean": "node ./scripts/clean.mjs",
    "lint": "eslint src/ bin/ scripts/ eslint-rules/ eslint.config.js vitest.config.ts vitest.pack.config.ts",
    "lint:ci": "eslint src/ bin/ scripts/ eslint-rules/ eslint.config.js vitest.config.ts vitest.pack.config.ts --max-warnings 0",
    "lint:fix": "eslint src/ bin/ scripts/ eslint-rules/ eslint.config.js vitest.config.ts vitest.pack.config.ts --fix",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "deadcode:check": "knip",
    "cycles:check": "dpdm --no-output --no-tree --no-warning --exit-code circular:1 bin/fireforge.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:firefox-full": "node ./scripts/run-full-firefox-integration.mjs",
    "whitespace:check": "node ./scripts/check-worktree-whitespace.mjs",
    "pack:dry-run": "npm pack --dry-run --json --silent",
    "pack:verify": "vitest run --config vitest.pack.config.ts",
    "format": "prettier --write --ignore-unknown \"src/**/*.ts\" \"bin/**/*.ts\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.js\" \"package.json\" \"eslint.config.js\" \"vitest.config.ts\" \"vitest.pack.config.ts\" \"tsconfig.json\" \"tsconfig.build.json\" \".lintstagedrc.json\" \".prettierignore\" \".prettierrc\" \".gitignore\" \"README.md\" \"CHANGELOG.md\" \"docs/**/*.md\" \"contributing/**/*.md\" \"knip.json\"",
    "format:check": "prettier --check --ignore-unknown \"src/**/*.ts\" \"bin/**/*.ts\" \"scripts/**/*.mjs\" \"eslint-rules/**/*.js\" \"package.json\" \"eslint.config.js\" \"vitest.config.ts\" \"vitest.pack.config.ts\" \"tsconfig.json\" \"tsconfig.build.json\" \".lintstagedrc.json\" \".prettierignore\" \".prettierrc\" \".gitignore\" \"README.md\" \"CHANGELOG.md\" \"docs/**/*.md\" \"contributing/**/*.md\" \"knip.json\"",
    "prepare": "node -e \"import('./scripts/prepare.mjs').catch((error) => { if (error && typeof error === 'object' && 'code' in error && error.code === 'ERR_MODULE_NOT_FOUND') process.exit(0); throw error; })\"",
    "prepack": "npm run build && node ./scripts/generate-build-info.mjs --loud",
    "release:check": "npm run toolchain:check && npm run format:check && npm run whitespace:check && npm run lint:ci && npm run typecheck && npm run deadcode:check && npm run cycles:check && npm run test:coverage && npm run build && npm run pack:verify",
    "prepublishOnly": "node ./scripts/prepublish-gate.mjs",
    "toolchain:check": "node ./scripts/check-release-toolchain.mjs"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "!dist/src/testing/",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts",
    "templates/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "acorn": "^8.14.0",
    "commander": "^15.0.0",
    "estree-walker": "^3.0.3",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^1.4.5",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "dpdm": "4.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "knip": "6.44.1",
    "lint-staged": "^17.0.4",
    "prettier": "3.9.10",
    "tsx": "^4.7.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.7",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@11.12.1",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/HominisBrowser/FireForge.git"
  },
  "homepage": "https://github.com/HominisBrowser/FireForge",
  "bugs": {
    "url": "https://github.com/HominisBrowser/FireForge/issues"
  },
  "keywords": [
    "fireforge",
    "firefox",
    "browser",
    "build-tool",
    "customization",
    "patch-workflow"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
